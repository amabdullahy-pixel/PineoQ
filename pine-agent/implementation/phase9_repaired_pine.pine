// External indicator series binding (formalization variable: 'pullback_score')
// The ARO script on the user's chart supplies the plot; no value is invented here.
// Select the matching ARO plot in the script settings (default: chart close).
pullback_score = input.source(close, title="Pullback Score")

// === MODULE M-STATE ===
// purpose: maintain the per-bar prior-value / crossover mechanics the contract requires
// dependencies: 
// source_requirements: C-1
// verification_requirements: logic_valid, edge_cases_checked, repaint_risk_classified
// Category: STATE - per-bar prior-value / crossover mechanics
// Contract condition (verbatim): Pullback_Score crosses over 30
// Pine v6: bool cannot be na (official migration guide); warm-up tracked via pullback_score availability
var bool state_crossover = false
// Initialize on first available bar; one logical update per confirmed bar
// Edge case E-NA: na values during warm-up keep the state inactive (no signal)
// Edge case E-FIRST: first bar has no previous pullback_score, so the state stays inactive
if na(pullback_score) or na(pullback_score[1])
    state_crossover := false
else
    state_crossover := pullback_score > 30 and pullback_score[1] <= 30


// === MODULE M-SIGNAL ===
// purpose: evaluate the contracted boolean conditions exactly as written (condition equivalence)
// dependencies: M-STATE
// source_requirements: C-1
// verification_requirements: logic_valid, ambiguities_resolved_or_recorded
// Category: SIGNAL - condition evaluation preserving the exact formalized clause
// Condition C-1 (verbatim): Pullback_Score crosses over 30
// Prerequisites: M-STATE
bool signal_c1 = false
if not na(pullback_score) and not na(pullback_score[1])
    signal_c1 := state_crossover
else
    signal_c1 := false
// Precedence: 1 (sole signal in this plan)


